{
  "name": "bike-map",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/bike-map/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/bike-map",
        "browser": "apps/bike-map/src/main.ts",
        "tsConfig": "apps/bike-map/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/bike-map/public"
          }
        ],
        "styles": [
          "apps/bike-map/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "bike-map:build:production"
        },
        "development": {
          "buildTarget": "bike-map:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "bike-map:build",
        "port": 4200,
        "staticFilePath": "dist/apps/bike-map/browser",
        "spa": true
      }
    },
    "cap-sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cap sync android"
      },
      "dependsOn": ["build"]
    },
    "cap-open": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cap open android"
      }
    },
    "cap-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cap run android"
      },
      "dependsOn": ["build"]
    },
    "build-apk": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "android",
        "command": "./gradlew assembleDebug"
      },
      "outputs": [
        "{workspaceRoot}/dist/android",
        "{workspaceRoot}/android/app/build/outputs/apk/debug"
      ],
      "dependsOn": ["cap-sync"]
    },
    "build-apk-release": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "android",
        "command": "./gradlew assembleRelease"
      },
      "outputs": [
        "{workspaceRoot}/dist/android",
        "{workspaceRoot}/android/app/build/outputs/apk/release"
      ],
      "dependsOn": ["cap-sync"]
    }
  }
}
